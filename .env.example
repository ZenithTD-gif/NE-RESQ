# ==============================================================================
# NE-RESQ — NORTHEAST EMERGENCY RESPONSE & SAFETY PLATFORM
# OFFICIAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY POLICY:
# 1. Never commit actual API keys, passwords, or tokens to GitHub or version control.
# 2. Never expose service role secrets or AI provider keys in client-side code (NEXT_PUBLIC_*).
# 3. For any unconfigured feed, NE-RESQ displays: "Service not connected — configuration required."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEB APPLICATION & RUNTIME DEPLOYMENT
# ------------------------------------------------------------------------------
# Purpose: Canonical base URL of the deployed application for redirects and absolute URLs.
# Docs: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & POSTGIS CLUSTER
# ------------------------------------------------------------------------------
# Provider: Supabase Managed PostgreSQL / PostGIS
# Purpose: Relational datastore, PostGIS spatial queries, Row Level Security (RLS), and Realtime streams.
# Docs: https://supabase.com/docs/guides/database
# Setup:
#   1. Create project at https://supabase.com
#   2. Apply schema migration: database/migrations/001_initial_schema.sql
#   3. Retrieve API keys from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. INDIA METEOROLOGICAL DEPARTMENT (IMD) INTEGRATION
# ------------------------------------------------------------------------------
# Provider: Ministry of Earth Sciences, Govt. of India (RMC Guwahati)
# Purpose: Real-time heavy rainfall, thunderstorm, and cyclone warning feeds.
# Docs: https://internal.imd.gov.in/section/nhac/dynamic/FAQ_RMC_Guwahati.pdf
# Institutional Approval Required: Yes (Institutional IP whitelisting or RMC Guwahati API token)
# Configuration Status: Optional. When empty, UI shows: "Service not connected — configuration required."
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=

# ------------------------------------------------------------------------------
# 4. NDMA SACHET COMMON ALERTING PROTOCOL (CAP) INTEGRATION
# ------------------------------------------------------------------------------
# Provider: National Disaster Management Authority (NDMA)
# Purpose: Early disaster warnings, red/orange/yellow CAP alerts, and cell broadcast metadata.
# Docs: https://sachet.ndma.gov.in
# Institutional Approval Required: Yes (Authorized SDMA / NDMA partner credentials)
# Configuration Status: Optional.
NDMA_SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public/v1
NDMA_SACHET_TOKEN=

# ------------------------------------------------------------------------------
# 5. CENTRAL WATER COMMISSION (CWC) HYDROLOGICAL FLOOD FORECAST
# ------------------------------------------------------------------------------
# Provider: Ministry of Jal Shakti, Govt. of India (Brahmaputra & Barak Basin)
# Purpose: Real-time river water levels, warning/danger levels, and discharge hydrographs.
# Docs: https://cwc.gov.in / https://ffs.india-water.gov.in
# Institutional Approval Required: Yes (CWC Basin Authority API registration)
# Configuration Status: Optional.
CWC_API_BASE_URL=https://ffs.india-water.gov.in/api
CWC_API_KEY=

# ------------------------------------------------------------------------------
# 6. ISRO / NRSC BHUVAN DISASTER MANAGEMENT SUPPORT (DMS)
# ------------------------------------------------------------------------------
# Provider: National Remote Sensing Centre (NRSC) / ISRO
# Purpose: Satellite flood inundation maps and landslide hazard zonation WMS/WFS layers.
# Docs: https://bhuvan-dms.nrsc.gov.in
# Institutional Approval Required: Yes (ISRO Bhuvan Enterprise GIS access)
# Configuration Status: Optional.
ISRO_BHUVAN_API_URL=https://bhuvan-app1.nrsc.gov.in/api/flood
ISRO_BHUVAN_API_KEY=

# ------------------------------------------------------------------------------
# 7. MAP TILER / MAPBOX SATELLITE ENGINE (OPTIONAL OVERLAY)
# ------------------------------------------------------------------------------
# Provider: MapTiler / Mapbox
# Purpose: High-resolution satellite aerial basemaps alongside CartoDB Dark Matter.
# Docs: https://docs.maptiler.com / https://docs.mapbox.com
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_access_token

# ------------------------------------------------------------------------------
# 8. AI EMERGENCY ASSISTANT (ZERO-HALLUCINATION RAG GATEWAY)
# ------------------------------------------------------------------------------
# Provider: Google Gemini API / OpenAI / Anthropic
# Purpose: Multi-language emergency triage, flood safety guidance, and disaster checklists.
# Docs: https://ai.google.dev / https://platform.openai.com/docs
# Approval Required: Developer API key
# Configuration Status: Optional (falls back to local NDMA rule-based protocol engine)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL DISPATCH (RESEND / AWS SES)
# ------------------------------------------------------------------------------
# Provider: Resend (https://resend.com)
# Purpose: Citizen SOS confirmation tokens, agency alerts, and magic-link logins.
# Docs: https://resend.com/docs
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=alerts@ne-resq.in

# ------------------------------------------------------------------------------
# 10. EMERGENCY SMS GATEWAY (GOVT DLT & DND WHITELISTED)
# ------------------------------------------------------------------------------
# Provider: CDAC National Mobile Governance / Twilio
# Purpose: Offline citizen SOS receipt SMS and high-priority broadcast SMS alerts.
# Docs: https://mgov.gov.in
# Approval Required: Telecom Regulatory Authority of India (TRAI) DLT Principal Entity registration
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_SENDER_ID=NERESQ

# ------------------------------------------------------------------------------
# 11. FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Provider: Google Firebase (FCM)
# Purpose: Critical push alerts to mobile devices during severe weather or evacuation orders.
# Docs: https://firebase.google.com/docs/cloud-messaging
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 12. INTERNAL SCHEDULED INGESTION & SECURITY SECRET
# ------------------------------------------------------------------------------
# Purpose: High-entropy secret guarding background sync endpoints (/api/cron/*).
CRON_SECRET=generate_high_entropy_random_secret_with_openssl_rand_hex_32
