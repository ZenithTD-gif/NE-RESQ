# ==============================================================================
# NE-RESQ — NORTHEAST EMERGENCY RESPONSE & SAFETY PLATFORM
# OFFICIAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY POLICY:
# 1. Never commit actual API keys, passwords, or tokens to GitHub or version control.
# 2. Never expose service role secrets or AI provider keys in client-side code (NEXT_PUBLIC_*).
# 3. For any unconfigured feed, NE-RESQ displays: "Service not connected — configuration required."
# ==============================================================================

# 1. WEB APPLICATION & RUNTIME DEPLOYMENT
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# 2. SUPER ADMINISTRATOR MASTER CREDENTIALS (SERVER-SIDE ONLY)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# 3. SUPABASE MANAGED POSTGRESQL & POSTGIS CLUSTER
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# 4. MAPTILER / MAPBOX SATELLITE & TOPO GIS ENGINE
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_access_token

# 5. AI EMERGENCY ASSISTANT (ZERO-HALLUCINATION RAG GATEWAY)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# 6. GOVERNMENT FEEDS (OPTIONAL - STRICT ZERO-MOCK STATUS)
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=
NDMA_SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public/v1
NDMA_SACHET_TOKEN=
CWC_API_BASE_URL=https://ffs.india-water.gov.in/api
CWC_API_KEY=
ISRO_BHUVAN_API_URL=https://bhuvan-app1.nrsc.gov.in/api/flood
ISRO_BHUVAN_API_KEY=

# 7. NOTIFICATIONS & SECURITY
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=alerts@ne-resq.in
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_SENDER_ID=NERESQ
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CRON_SECRET=generate_high_entropy_random_secret_with_openssl_rand_hex_32
